{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ModelService": {
    "BaseUrl": "http://localhost:8000"
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=vision_detect;Username=vduser;Password=vdpassword"
  },
  "Storage": {
    "ImagePath": "images"
  },
  "Queue": {
    "Capacity": 100
  },
  "Cors": {
    "Origins": [ "http://localhost:5173", "http://127.0.0.1:5173" ]
  },
  "Resilience": {
    "AttemptTimeoutSeconds": 10,
    "MaxRetryAttempts": 3,
    "BaseDelaySeconds": 2,
    "FailureRatio": 0.5,
    "MinimumThroughput": 4,
    "SamplingDurationSeconds": 30,
    "BreakDurationSeconds": 15
  },
  "Worker": {
    "MaxAttempts": 3,
    "RequeueDelaySeconds": 20
  }
}
