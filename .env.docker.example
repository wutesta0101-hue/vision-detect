# ============================================================
# Docker 部署環境變數範本
#
# 使用方式：
#   1. 複製為 .env（注意檔名是 .env，不是 .env.docker）
#        PowerShell:  Copy-Item .env.docker.example .env
#        Mac/Linux:   cp .env.docker.example .env
#   2. 編輯 .env 修改密碼
#   3. docker compose up -d 會自動讀取 .env
#
# 🔴 檔名必須是 .env。
#    Docker Compose 只自動讀取這個名稱，其他名稱需要 --env-file；
#    而忘記加參數時 compose 不會報錯，只會靜靜套用預設值。
#
# .env 已列在 .gitignore，不會進版控。
# ============================================================

# ====== 資料庫 ======
POSTGRES_USER=vduser
POSTGRES_PASSWORD=請改成你的密碼
POSTGRES_DB=vision_detect

# ====== pgAdmin ======
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=請改成你的密碼

# ====== 對外連接埠 ======
# 80 被佔用時可改成其他值，例如 8000
HTTP_PORT=80
PGADMIN_PORT=8080

# ====== 模型設定 ======
MODEL_VERSION=yolov8n-coco
CONFIDENCE_THRESHOLD=0.25
MAX_CONCURRENCY=1
